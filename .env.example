# Production PostgreSQL (Neon / Supabase / Prisma Postgres / any managed PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Auth
NEXTAUTH_URL="https://your-domain.com"
NEXTAUTH_SECRET="generate-a-long-random-secret"

# Encryption at rest. NEVER commit these values.
DATA_ENCRYPTION_KEY="generate-a-strong-32+ character secret"
DATA_HASH_SECRET="generate-a-different-strong-secret"

# Razorpay
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxx"

# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN="EAxxxxxxxxxxxxxxxx"
WHATSAPP_PHONE_NUMBER_ID="123456789012345"
WHATSAPP_GRAPH_VERSION="v25.0"
# Meta App Secret (used only to verify x-hub-signature-256 webhooks)
WHATSAPP_APP_SECRET=""
# Any long random string you choose; enter the same value in Meta webhook settings
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# Temporary test recipient or, later, the café owner's WhatsApp number
WHATSAPP_OWNER_PHONE=""
# Exact approved template name used for new-order alerts to the owner
WHATSAPP_OWNER_ORDER_TEMPLATE=""
WHATSAPP_TEMPLATE_LANGUAGE="en_US"
WHATSAPP_OTP_TEMPLATE="oat_ember_otp"
WHATSAPP_ORDER_ACCEPTED_TEMPLATE="oat_ember_order_accepted"
WHATSAPP_ORDER_PREPARED_TEMPLATE="oat_ember_order_prepared"
WHATSAPP_ORDER_READY_TEMPLATE="oat_ember_order_ready"

# Email (optional but useful for owner/customer receipts)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="Oat & Ember <your-email@gmail.com>"
ADMIN_NOTIFICATION_EMAIL="owner@cafe.com"

# Admin seed credentials — set your own before seeding production
ADMIN_NAME="Café Admin"
ADMIN_EMAIL="owner@cafe.com"
ADMIN_PHONE="9999999999"
ADMIN_PASSWORD="replace-this-before-production"

# Production checkout reconciliation
RAZORPAY_WEBHOOK_SECRET="set-this-to-the-secret configured in Razorpay webhooks"

# Café ordering hours (Asia/Kolkata by default)
ORDERING_TIME_ZONE="Asia/Kolkata"
ORDERING_START_HOUR="7"
ORDERING_END_HOUR="22"

# Google OAuth (optional until enabled in Google Cloud Console)
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://YOUR-VERCEL-DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
